# copy to .env and adjust; .env is git-ignored. Every value has a default in the config files.

# Part 1 - UI
BASE_URL=https://automationteststore.com
HEADLESS=true
EXPECT_TIMEOUT=15000

# Part 2 - API
API_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim blocks requests without a User-Agent; their policy asks for an app name + contact
API_USER_AGENT=Toptal-Test-Anubhav/1.0
API_TIMEOUT=20
# OpenStreetMap Notes API (dev server) for the create/update tests; leave empty to skip them
OSM_API_URL=https://master.apis.dev.openstreetmap.org/api/0.6
OSM_DEV_TOKEN=

# Part 3 - Load
LOAD_BASE_URL=https://quickpizza.grafana.com
# text every good homepage response must contain
LOAD_EXPECT_TEXT=<title>QuickPizza</title>
LOAD_USERS=1000
LOAD_RAMP_SECONDS=15
LOAD_GRACE_SECONDS=5
PROBE_SAMPLES=10
